# =============================================================================
# Second-Screen EPL Broadcast Agent
# Local environment variables. Copy to `.env` (git-ignored) and fill in.
# Never commit `.env`. Production secrets live in Google Secret Manager.
# =============================================================================

# ------------------------------------------------------------------ GCP core
# Project ID you created in Phase 0 (see docs/runbooks/phase0-provisioning.md).
GCP_PROJECT_ID=sf-fan360
GCP_REGION=europe-central2
GCP_BQ_LOCATION=EU

# Absolute path to the ETL service-account JSON key (kept inside .secrets/).
GOOGLE_APPLICATION_CREDENTIALS=.secrets/etl-service.json

# BigQuery datasets the ETL writes to.
BQ_DATASET_RAW=sf_fan360_raw
BQ_DATASET_MARTS=sf_fan360_marts

# GCS bucket for raw Parquet.
GCS_RAW_BUCKET=sf-fan360-raw

# --------------------------------------------------------------- Data source API keys
# Football-Data.org free tier: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# API-Football (api-sports) free tier: https://dashboard.api-football.com/
# Register, choose the Free plan, copy your API key from the dashboard.
# REST base URL: https://v3.football.api-sports.io  |  Header: x-apisports-key
# Leave blank to skip API-Football calls; the live feed uses FPL polling only.
API_FOOTBALL_KEY=

# -------------------------------------------------------------- LLM (Gemini AI Studio)
# Google AI Studio free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=text-embedding-004

# -------------------------------------------------------------- Salesforce
# Default org alias used by `sf` CLI. Created in Phase 0:
#   sf org login web -a football_agent
SF_ORG_ALIAS=football_agent

# Data Cloud Ingestion API connected-app credentials (Phase 3).
SF_INGEST_CLIENT_ID=
SF_INGEST_USERNAME=
SF_INGEST_PRIVATE_KEY_PATH=.secrets/sf-ingest-private.key
SF_INGEST_AUDIENCE=https://login.salesforce.com

# Shared secret signing requests between Salesforce Named Credential and the
# Cloud Run llm-shim (Phase 6). Generate with: openssl rand -hex 32
LLM_SHIM_SHARED_SECRET=

# Public URL of the deployed llm-shim (filled in after Phase 6 cloud deploy).
LLM_SHIM_URL=

# -------------------------------------------------------------- Local dev only
# Set to `1` to skip GCS uploads and write Parquet to ./data/ instead.
# Useful during Phase 1 if billing is not yet enabled on the GCP project.
ETL_LOCAL_ONLY=0
