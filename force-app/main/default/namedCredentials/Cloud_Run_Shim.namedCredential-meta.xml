<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Cloud Run Shim</label>
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>true</allowMergeFieldsInHeader>
    <calloutOptions>
        <generateAuthorizationHeader>true</generateAuthorizationHeader>
    </calloutOptions>
    <endpoint>callout:Cloud_Run_Shim_Credential</endpoint>
    <generateAuthorizationHeader>true</generateAuthorizationHeader>
    <namedCredentialParameters>
        <parameterName>HttpHeader.X-Shim-Auth</parameterName>
        <parameterType>HttpHeader</parameterType>
        <parameterValue>{!$Credential.Cloud_Run_Shim_Credential.SharedSecret}</parameterValue>
    </namedCredentialParameters>
    <principalType>NamedUser</principalType>
    <protocol>NoAuthentication</protocol>
</NamedCredential>
